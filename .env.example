# Project Configuration
COMPOSE_PROJECT_NAME=prod_abc
APP_NAME=abc
ENV=prod

# Host Configuration
# Bound to 127.0.0.1 only — reach the app via host Nginx, not the public CONTAINER_PORT.
CONTAINER_PORT=8000
HOST_URL=abc.com
HOST_PORT=80

# Cron and Job Configuration
ENABLE_CRON=false
ENABLE_JOB=false
QUEUE_COMMAND=queue:work
QUEUE_OPTIONS="--sleep=5 --tries=2 --timeout=300"

# PHP Configuration
PHP_VERSION=8.3
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=30M
PHP_POST_MAX_SIZE=30M
PHP_MAX_EXECUTION_TIME=60

# Container memory limits (Docker mem_limit)
PHP_CONTAINER_MEMORY=1g
NGINX_CONTAINER_MEMORY=128m
JOB_CONTAINER_MEMORY=512m
CRON_CONTAINER_MEMORY=256m

# MongoDB Extension Configuration
ENABLE_MONGODB_EXTENSION=false
ENABLE_MONGODB_EXTENSION_VERSION=1.20.0

# SQLite Extension Configuration
ENABLE_SQLITE_EXTENSION=false

# Node.js / npm (Vite, React, Vue). Use "Docker Compose Rebuild (no-cache)" after changing.
NPM=false
NODE_VERSION=20
